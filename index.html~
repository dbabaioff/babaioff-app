      { id: "lRWgH1CKHmM", title: "להקת אשירה || ועל הכל :: הפעם אודה :: יוסף הצדיק" },
      { id: "dPR6v_cywuU", title: "להקת אהללה - מחרוזת שירי שבת" },
      { id: "fVtUmKtEomw", title: "להקת זמרת הארץ - להקה לחתונה - בורא עולם | כי יש ה' (הרב יהושע שפירא) | ובכן צדיקים | תרננה שפתי"},
      { id: "2AWLqffzR9k", title: "לכה דודי - אומנים שונים"},
      { id: "9oDlNJle_Bs", title: "הראל טל ולהקתו - קליפ שירי חתונה | ברוך הוא | מזמור לתודה | מחשבות טובות"},
      { id: "_DEatQdfg6s", title: "תרננה שפתי - אודי דוידי"},
      { id: "GAfCioh7Mp4", title: "תתן אחרית לעמך - הראל טל"},
      { id: "dEVasMk6Hjs", title: "בואו שעריו בתודה | ישיבת רמת גן ולהקת זמרת הארץ"},
      { id: "C9Ddlab63PM", title: "חמול על מעשיך - ניגון לימים נוראים | ישיבת רועה ישראל"},
      { id: "A7d2i3LuD0M", title: "להקת אשירה - מחרוזת מזמור לתודה! 🇮🇱"},
      { id: "xJ9aLwbGeCs", title: "יצחק מאיר - והביאותים - מתוך סליחות תשעז"},
      { id: "ryTO71_eMO4", title: "נתן גושן וישי ריבו - נחכה לך"},
      { id: "QURkPwVwjKs", title: "מחרוזת פורים איחוד הלהקות - מזמור שיר, אהללה, לב טהור, להבה, שיר חדש, נכספה"},
      { id: "bltg_9sEqFg", title: "אורי שבח ובניו | עונג שבת"},
      { id: "bltg_9sEqFg", title: "אורי שבח ובניו | עונג שבת"},
      { id: "1QuNAhONztA", title: "מחרוזת שירי שבת חדשה!! להקת נשמחה - להקה לחתונה והישיבה הקדם צבאית ברוכין"},
      { id: "C-Tk8scbygI", title: "מחרוזת סוכות איחוד הלהקות מארחים את מרדכי יצהר- אהללה, מזמור שיר, שיר חדש, נשמחה, הניגון שבלב"},
      { id: "VYjIKJppUGc", title: "ממקומך - יונתן רזאל וישיבת אורות שאול"},
      { id: "DWVNVnFn9nw", title: "קבלת שבת ישיבת נחלת יוסף שבי שומרון"},
      { id: "TBt-55E6nEs", title: "להקת אשירה מארחת את ישיבת אלון מורה • מחרוזת שירי גאולה!🇮🇱 הושיעה את עמך - קה זכות אבות -יבנה המקדש"},
    ],
    אליהו: [
      { id: "BAUagghhHno", title: "עקיבא | יש בך הכל" },
      { id: "XzeyFpGtCUE", title: "עקיבא | צעדים" },
      { id: "Y30pfWIQfoo", title: "ישי ריבו - לשוב הביתה" },
      { id: "T5Wf3gmF6Do", title: "ישי ריבו - סיבת הסיבות" }
    ]
  },
  shiurim: {
    "הרב שמואל אליהו": [
      { id: "9NHPq0KFbns", title: "חיים כהלכה | שאלות ותשובות עם הרב שמואל אליהו בהנחיית הרב אבי ברמן | לערב שבת פרשת חיי שרה תשפו" }
    ],
    test: [
      
    ]
  }
};

let currentListItems = [];

let tag = document.createElement('script');
tag.src = "https://www.youtube.com/iframe_api";
document.body.appendChild(tag);

let player;
let currentVideoId = null;
let isPlaying = false;

function onYouTubeIframeAPIReady() {
  player = new YT.Player('player', {
    height: '1',
    width: '1',
    videoId: '',
    playerVars: { autoplay: 0, controls: 0, modestbranding: 1 },
    events: { 'onStateChange': onPlayerStateChange }
  });
}

function onPlayerStateChange(event) {
  isPlaying = event.data === YT.PlayerState.PLAYING;

  // When video ends:
  if (event.data === YT.PlayerState.ENDED) {
    playNextVideo();
  }
}

function playNextVideo() {
  if (!currentVideoId) return;

  // Find index of current video in the list
  const index = currentListItems.findIndex(v => v.id === currentVideoId);

  if (index === -1) return; // not found
  if (index === currentListItems.length - 1) return; // reached end of list

  // Load next video
  const nextVideo = currentListItems[index + 1];
  currentVideoId = nextVideo.id;
  player.loadVideoById(nextVideo.id);

  // Update active highlight in UI
  document.querySelectorAll('#videoList li').forEach(el => {
    el.classList.remove('active');
  });
  const li = document.querySelector(`#videoList li[data-id="${nextVideo.id}"]`);
  if (li) li.classList.add('active');
}

function autoDir(text) {
    return /[\u0590-\u05FF]/.test(text) ? "rtl" : "ltr";
}

// Step 1: click on main category
document.getElementById('categoryScreen').addEventListener('click', e => {
  const cat = e.target.closest('.category');
  if (!cat) return;
  const category = cat.dataset.category;
  showSubcategories(category);
});

// Step 2: show subcategories
function showSubcategories(category) {
  const subcategoryScreen = document.getElementById('subcategoryScreen');
  subcategoryScreen.innerHTML = '';

  const subcategories = Object.keys(videoData[category]);
  subcategories.forEach(sub => {
    const div = document.createElement('div');
    div.className = 'category';
    div.textContent = sub;
    div.dataset.category = category;
    div.dataset.subcategory = sub;
    subcategoryScreen.appendChild(div);
  });

  document.getElementById('categoryScreen').style.display = 'none';
  subcategoryScreen.style.display = 'grid';
  document.getElementById('backButton').style.display = 'inline-block';
  document.getElementById('pageTitle').textContent = '🎵 Choose a Subcategory';
}

// Step 3: click on subcategory
document.getElementById('subcategoryScreen').addEventListener('click', e => {
  const sub = e.target.closest('.category');
  if (!sub) return;
  const { category, subcategory } = sub.dataset;
  showVideoList(category, subcategory);
});

// Step 4: show list of videos
function showVideoList(category, subcategory) {
  const list = document.getElementById('videoList');
  list.innerHTML = '';
  
  currentListItems = videoData[category][subcategory];


  videoData[category][subcategory].forEach(v => {
    const li = document.createElement('li');
    const img = document.createElement('img');
    img.src = `https://img.youtube.com/vi/${v.id}/mqdefault.jpg`;
    img.alt = v.title;
    
    const span = document.createElement('span');
    span.textContent = v.title;
    span.dir = autoDir(v.title);
    
    li.appendChild(img);
    li.appendChild(span);
    li.dataset.id = v.id;
    list.appendChild(li);
  });

  document.getElementById('subcategoryScreen').style.display = 'none';
  list.style.display = 'block';
  document.getElementById('pageTitle').textContent = '🎧 Choose a Track';
}

// Back button
document.getElementById('backButton').addEventListener('click', () => {
  if (player && isPlaying) player.stopVideo();

  const list = document.getElementById('videoList');
  const sub = document.getElementById('subcategoryScreen');
  const cat = document.getElementById('categoryScreen');

  if (list.style.display === 'block') {
    list.style.display = 'none';
    sub.style.display = 'grid';
    document.getElementById('pageTitle').textContent = '🎵 Choose a Subcategory';
  } else if (sub.style.display === 'grid') {
    sub.style.display = 'none';
    cat.style.display = 'grid';
    document.getElementById('backButton').style.display = 'none';
    document.getElementById('pageTitle').textContent = '🎧 Choose a Category';
  }

  currentVideoId = null;
});

// Handle video click
document.getElementById('videoList').addEventListener('click', function(e) {
  const li = e.target.closest('li');
  if (!li) return;
  const videoId = li.dataset.id;
  document.querySelectorAll('#videoList li').forEach(el => el.classList.remove('active'));

  if (videoId === currentVideoId) {
    if (isPlaying) {
      player.pauseVideo();
      li.classList.remove('active');
    } else {
      player.playVideo();
      li.classList.add('active');
    }
  } else {
    currentVideoId = videoId;
    player.loadVideoById(videoId);
    li.classList.add('active');
  }
});
</script>


</body>
</html>

